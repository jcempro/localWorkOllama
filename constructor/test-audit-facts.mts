import assert from 'node:assert/strict';import fs from 'node:fs';import {createHash} from 'node:crypto';const file=new URL('./audit-facts.mts',import.meta.url);if(!fs.existsSync(file))throw Error('ARQUIVO_A_CRIAR: constructor/audit-facts.mts; use write_file com a implementacao antes de validar.');const {extractAuditFactsA3F:f}=await import(file);assert.equal(typeof f,'function');const a='11111111-1111-4111-8111-111111111111',b='22222222-2222-4222-8222-222222222222',c='33333333-3333-4333-8333-333333333333',d='44444444-4444-4444-8444-444444444444',secret='PRIVATE_A3F_DO_NOT_EMIT';const old={id:a,state:{status:'COMPLETED'},events:[]};const cancelled={id:d,state:{status:'CANCELLED'},events:[]};const fresh={id:b,state:{status:'FAILED',step:9,context_compactions:0,error_kind:'WORKER_INCOMPLETE'},request:{required_read_paths:[secret],required_command_ids:['x','y'],command_sequence:['x']},task:secret,result:secret,error:secret,events:[{line:1,phase:'tool_result',step:1,tool:'read_file',outcome:'ok',payload:secret},{line:2,phase:'tool_result',step:2,tool:'edit_file',outcome:'ok'},{line:3,phase:'tool_result',step:3,tool:'write_file',outcome:'ok'},{line:4,phase:'tool_result',step:4,tool:'run_authorized_command',outcome:'ok'},{line:5,phase:'tool_result',step:5,tool:'edit_file',outcome:'error'},{line:6,phase:'tool_result',step:6,tool:'read_file',outcome:'rejected'},{line:7,phase:'other',step:8,tool:'read_file',outcome:'ok'}]};const missing={id:c,state:{status:'COMPLETED',step:0},events:[]};const current=JSON.stringify({jobs:[missing,cancelled,fresh,old],paths:secret}),baseline=JSON.stringify({jobs:[old,cancelled]});const out=f(current,baseline);assert.equal(out.schema,1);assert.deepEqual(out.counts,{current:3,baseline:1,new:2});assert.deepEqual(out.rows.map(r=>r.id),[b,c]);assert.deepEqual(out.hashes,{current:createHash('sha256').update(current).digest('hex'),baseline:createHash('sha256').update(baseline).digest('hex')});const row=out.rows[0],empty=out.rows[1];assert.equal(row.error_kind,'WORKER_INCOMPLETE');assert.equal(row.reported_step,9);assert.equal(row.max_logged_step,8);assert.equal(row.context_compactions,0);assert.deepEqual(row.tool_counts,{read_file_ok:1,direct_mutation_ok:2,authorized_command_ok:1,errors:1,rejected:1});assert.deepEqual(row.success_lines,[1,2,3,4]);assert.deepEqual(row.error_lines,[5]);assert.deepEqual(row.rejected_lines,[6]);assert.equal(row.required_reads_count,1);assert.equal(row.required_commands_count,2);assert.equal(row.sequence_length,1);assert.equal(row.result_present,true);assert.equal(row.git_section_present,false);assert.equal(row.semantic_acceptance,'NOT_ASSESSED');for(const key of ['max_logged_step','context_compactions','required_reads_count','required_commands_count','sequence_length'])assert.equal(empty[key],null,key);assert.equal(empty.reported_step,0);assert.equal(empty.result_present,false);assert.equal(JSON.stringify(out).includes(secret),false);assert.deepEqual(f(current,baseline),out);assert.equal(f(baseline,baseline).rows.length,0);for(const invalid of ['{',JSON.stringify({jobs:{}}),JSON.stringify({jobs:[old,old]}),JSON.stringify({jobs:[{...old,id:'bad'}]}),JSON.stringify({jobs:[{...old,state:{status:'bad'}}]}),JSON.stringify({jobs:[{...old,events:{}}]})])assert.throws(()=>f(invalid,baseline));assert.throws(()=>f(current,JSON.stringify({jobs:[old,old]})));const unknown=f(JSON.stringify({jobs:[{...fresh,state:{status:'FAILED',error_kind:secret}}]}),JSON.stringify({jobs:[]}));assert.equal(unknown.rows[0].error_kind,'OTHER');assert.equal(JSON.stringify(unknown).includes(secret),false);const marked=f(JSON.stringify({jobs:[{...fresh,result:'ESTADO GIT DETERMINÍSTICO'}]}),baseline);assert.equal(marked.rows[0].git_section_present,true);const lower={...old,id:'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa'};assert.throws(()=>f(JSON.stringify({jobs:[lower,{...lower,id:lower.id.toUpperCase()}]}),baseline));console.log('A3F_HELPER_ASSERTS_OK; diff/filtros/contagens/linhas/hashes/privacidade/ausente-vs-zero/invalidos/determinismo');

